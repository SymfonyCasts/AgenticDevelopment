{% extends 'base.html.twig' %}

{% block body %}
    <main class="flex-1 max-w-6xl w-full mx-auto px-6 py-10">
        <div class="mb-8">
            <h2 class="font-display text-2xl sm:text-3xl text-tardis-dark mb-2">Recently Recovered Items</h2>
            <p class="text-slate-600 max-w-2xl">
                Items materialize here after being left behind across all the time and space. Recognize something?
                Select it below to view details and file a claim.
            </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for id, item in items %}
                <li>
                    <div class="{{ item.colorClass }} rounded-xl h-56 flex items-center justify-center border-2 border-tardis-50 mb-6 py-2">
                        <img class="h-full w-auto" src="{{ asset(item.image) }}" alt="{{ item.name }}">
                    </div>
                    <h3 class="font-display text-2xl text-tardis-dark mb-3">{{ item.name }}</h3>
                    <p class="text-slate-600 mb-4 line-clamp-3">{{ item.description }}</p>
                    <a href="{{ path('app_items_show', {id: id}) }}"
                       aria-label="Claim {{ item.name }}"
                       class="block text-center bg-accent hover:bg-accent-dark text-white font-semibold px-5 py-3 rounded-lg transition-colors">Claim Item</a>
                </li>
            {% else %}
                <li class="col-span-full text-slate-600">
                    Nothing has materialized yet. Check back in a century or two.
                </li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
